  "diff": "--- monthly_net_revenue.sql (before)\n+++ monthly_net_revenue.sql (repaired)\n@@ -1,8 +1,8 @@\n -- Finance close pack: net revenue by month, off the revenue fact.\n--- Reads analytics.marts.fct_revenue — net_amount_usd is the column the\n+-- Reads analytics.marts.fct_revenue — net_revenue_usd is the column the\n -- repair drill renames out from under this query.\n SELECT strftime('%Y-%m', revenue_date) AS month,\n-       ROUND(SUM(net_amount_usd), 2) AS net_revenue,\n+       ROUND(SUM(net_revenue_usd), 2) AS net_revenue,\n        COUNT(*) AS payments\n FROM fct_revenue\n GROUP BY 1\n\n--- refund_drag.sql (before)\n+++ refund_drag.sql (repaired)\n@@ -1,6 +1,6 @@\n -- Refund drag: what refunds cost against gross, and the net share that survives.\n--- Reads analytics.marts.fct_revenue on both gross_amount_usd and net_amount_usd.\n-SELECT ROUND(SUM(gross_amount_usd) - SUM(net_amount_usd), 2) AS refund_drag_usd,\n-       ROUND(SUM(net_amount_usd) / SUM(gross_amount_usd), 4) AS net_share\n+-- Reads analytics.marts.fct_revenue on both gross_amount_usd and net_revenue_usd.\n+SELECT ROUND(SUM(gross_amount_usd) - SUM(net_revenue_usd), 2) AS refund_drag_usd,\n+       ROUND(SUM(net_revenue_usd) / SUM(gross_amount_usd), 4) AS net_share\n FROM fct_revenue;\n \n",
