  "diff": "--- delivery_cost_share.sql (before)\n+++ delivery_cost_share.sql (repaired)\n@@ -1,5 +1,5 @@\n -- Margin watch: delivery cost as a share of order revenue.\n--- Reads order_details on cost_of_delivery and order_total.\n-SELECT ROUND(SUM(cost_of_delivery) / SUM(order_total), 4) AS delivery_share\n+-- Reads order_details on delivery_cost_usd and order_total.\n+SELECT ROUND(SUM(delivery_cost_usd) / SUM(order_total), 4) AS delivery_share\n FROM order_details;\n \n\n--- revenue_net_of_delivery.sql (before)\n+++ revenue_net_of_delivery.sql (repaired)\n@@ -1,10 +1,10 @@\n -- Commercial pack: revenue net of delivery, by customer class.\n--- Reads order_details — cost_of_delivery is the column the repair drill\n+-- Reads order_details — delivery_cost_usd is the column the repair drill\n -- renames out from under this query.\n SELECT customer_class,\n        ROUND(SUM(order_total), 2) AS total_revenue,\n-       ROUND(SUM(cost_of_delivery), 2) AS delivery_cost,\n-       ROUND(SUM(order_total) - SUM(cost_of_delivery), 2) AS net_revenue\n+       ROUND(SUM(delivery_cost_usd), 2) AS delivery_cost,\n+       ROUND(SUM(order_total) - SUM(delivery_cost_usd), 2) AS net_revenue\n FROM order_details\n GROUP BY customer_class\n ORDER BY customer_class;\n",
