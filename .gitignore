# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# builds
build/
dist/

# env & secrets — never commit
.env
.env.local
.env.*.local
*.key
credentials.json
*.pem

# misc
.DS_Store
*.log
npm-debug.log*
.vercel

# python
__pycache__/
*.pyc
.venv/

# test
coverage/
tsconfig.tsbuildinfo

# runtime user data (handoffs). Ignore the contents rather than the directory
# itself, or git never descends far enough for the exception below to apply.
data/*
# The recorded demo session ships, so the hosted demo needs no API key.
!data/replay/
data/replay/*
!data/replay/session.json

# Proposed runbook corrections (regenerated by `npm run propose`). Anchored, so it
# does not also swallow the worked example committed under examples/proposals/.
/proposals/

# Eval resume cache (regenerated locally)
evals/results/cache.json
