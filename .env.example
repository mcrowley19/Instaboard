# ── Demo mode ────────────────────────────────────────────────────────────
# Set to true to answer all DataHub tools from the built-in Northbeam fixture
# catalog — no DataHub instance needed (you still need an LLM key below or in
# the app's Settings).
DEMO_MODE=false

# ── DataHub ──────────────────────────────────────────────────────────────
# URL of your DataHub GMS server (default matches `datahub docker quickstart`)
DATAHUB_GMS_URL=http://localhost:8080
# Personal access token — leave empty for a local quickstart (no auth)
DATAHUB_GMS_TOKEN=

# ── LLM provider (optional — can also be set per-user in the app UI) ─────
# One of: anthropic | openrouter | gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional model override (defaults: claude-opus-4-8 / anthropic/claude-sonnet-4.5 / gemini-2.5-pro)
LLM_MODEL=
