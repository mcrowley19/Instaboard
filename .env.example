# ── Demo mode ────────────────────────────────────────────────────────────
# Set to true to answer all DataHub tools from the built-in Northbeam fixture
# catalog — no DataHub instance needed (you still need an LLM key below or in
# the app's Settings).
DEMO_MODE=false

# ── DataHub ──────────────────────────────────────────────────────────────
# URL of your DataHub GMS server (default matches `datahub docker quickstart`)
DATAHUB_GMS_URL=http://localhost:8080
# Personal access token — leave empty for a local quickstart (no auth)
DATAHUB_GMS_TOKEN=

# ── LLM provider (optional — can also be set per-user in the app UI) ─────
# One of: anthropic | openrouter | gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional model override (defaults: claude-opus-4-8 / anthropic/claude-sonnet-4.5 / gemini-2.5-pro)
LLM_MODEL=

# `npm run eval` reads these too — the CLI can't see a key you pasted into the
# app's Settings, so set them here to run the benchmark.
#
# No budget? Both of these are free and support tool calling:
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# or Google AI Studio's free tier (no card required):
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-2.5-flash
#
# Free tiers meter per minute and per day. The eval caches every completed case
# to evals/results/cache.json and resumes, so hitting a cap pauses the run
# rather than losing it — re-run when the quota resets. Use --concurrency=1 if
# your provider is strict about requests per minute.

# ── Hosted write-back demo ───────────────────────────────────────────────
# Off by default, and it should stay off anywhere the catalog matters.
#
# With this set, /api/demo/writeback will drop a column from a real dataset,
# catch the drift, write an incident + tag + failing assertion into DataHub,
# read all three back, and then put the column back — the loop `npm run prove`
# runs, but from a link a judge can click.
#
# It only ever touches the three datasets the demo runbook names, serialises
# visitors, and restores in a `finally`. It is still a deliberate break of a
# live catalog: point it at a disposable DataHub, never at one anyone relies on.
DEMO_WRITEBACK_ENABLED=false
# Where to send "open this in DataHub" links. Defaults to the GMS URL with
# :8080 swapped for :9002, which is right for a local quickstart and wrong for
# most other deployments.
DATAHUB_FRONTEND_URL=
